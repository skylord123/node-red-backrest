    {
        "type": "function",
        "name": "Describe backup",
        "func": "const r = msg.payload;\nconst mb = ((r.summary && r.summary.dataAdded) || 0) / 1e6;\nmsg.payload = `Backed up ${r.planId} in ${Math.round(r.durationMs / 1000)}s, ` +\n    `${mb.toFixed(1)} MB added (snapshot ${r.snapshotId.slice(0, 8)})`;\nreturn msg;",
