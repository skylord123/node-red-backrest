    {
        "type": "function",
        "name": "Describe",
        "func": "const op = msg.payload;\nconst seconds = (Number(op.unixTimeEndMs) - Number(op.unixTimeStartMs)) / 1000;\nmsg.payload = `${op.planId}: ${msg.status.replace(\"STATUS_\", \"\").toLowerCase()} after ${Math.round(seconds)}s`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
