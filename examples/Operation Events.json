    {
        "type": "function",
        "name": "Progress",
        "func": "const status = msg.payload.operationBackup && msg.payload.operationBackup.lastStatus &&\n    msg.payload.operationBackup.lastStatus.status;\nif (msg.status !== \"STATUS_INPROGRESS\" || !status) return null;\nmsg.payload = `${msg.payload.planId}: ${Math.round(status.percentDone * 100)}% (${status.filesDone || 0} files)`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
