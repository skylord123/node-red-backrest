        "func": "const s = msg.payload;\nconst problem = s.overdue ? \"is overdue\" : s.state === \"error\" ? \"failed\" : \"finished with warnings\";\nconst last = s.lastBackup ? new Date(s.lastBackup.time).toLocaleString() : \"never\";\nmsg.payload = `Backups of ${s.id} ${problem} (last backup: ${last})`;\nreturn msg;",
